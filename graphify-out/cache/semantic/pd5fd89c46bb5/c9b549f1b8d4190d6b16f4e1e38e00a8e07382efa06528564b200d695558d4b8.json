{"nodes": [{"id": "readme_eit_framework", "label": "EIT Simulation & Reconstruction Framework", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_three_stage_pipeline", "label": "mesh_tools -> make_ground_truth -> simulate pipeline", "file_type": "concept", "source_file": "README.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_inverse_crime", "label": "Inverse Crime Avoidance (fine truth mesh, coarser recon mesh)", "file_type": "rationale", "source_file": "README.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simulating and inverting on the same discretisation cancels discretisation error, flatters every algorithm and shifts the ranking between algorithms; storing truth once on its own fine mesh keeps the benchmark honest."}, {"id": "readme_ground_truth_bundle", "label": "Ground-truth bundle (GT_simulated_result/<name>/)", "file_type": "concept", "source_file": "README.md", "source_location": "L609", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_circular_mesh_generation", "label": "Circular cross-section meshing (gmsh, cached by hash)", "file_type": "concept", "source_file": "README.md", "source_location": "L125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test cell is a cylinder so the cross-section is always a circle; h_edge < h_center because EIT is most sensitive near electrodes; dense GN normal equations cost n_cells^3."}, {"id": "readme_drive_patterns", "label": "Current drive patterns (opposite, adjacent, one-against-all, trigonometric, all-against-one)", "file_type": "concept", "source_file": "README.md", "source_location": "L197", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At most L-1 independent patterns due to charge conservation; adjacent for boundary targets, trigonometric for centre sensitivity."}, {"id": "readme_cheney_isaacson", "label": "Cheney/Isaacson trigonometric basis", "file_type": "paper", "source_file": "README.md", "source_location": "L204", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_declarative_phantoms", "label": "Declarative conductivity phantoms", "file_type": "concept", "source_file": "README.md", "source_location": "L214", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pure function of position lets the same phantom be sampled on both the fine truth mesh and coarse reconstruction mesh; random placements are frozen in the bundle for reproducibility."}, {"id": "readme_noise_relative_to_max", "label": "relative_to_max noise model (default)", "file_type": "rationale", "source_file": "README.md", "source_location": "L297", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-measurement relative noise makes near-zero channels arbitrarily accurate, which no instrument does and flatters algorithms unequally; a constant front-end noise floor is physical. Fixed noise seed gives every algorithm the same noise."}, {"id": "readme_electrode_gain_error", "label": "Electrode gain calibration error", "file_type": "concept", "source_file": "README.md", "source_location": "L310", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_parameter_sweep", "label": "List-valued config as sweep axis (cartesian product)", "file_type": "concept", "source_file": "README.md", "source_location": "L341", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_gauss_newton_gn", "label": "gn: Gauss-Newton with quadratic prior", "file_type": "concept", "source_file": "README.md", "source_location": "L398", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_gn_total_variation", "label": "tv: Gauss-Newton with total variation", "file_type": "concept", "source_file": "README.md", "source_location": "L417", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_l1_sparsity", "label": "l1: L1-sparsity reconstruction", "file_type": "concept", "source_file": "README.md", "source_location": "L426", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "alpha is not auto-scaled because iterative soft-thresholding does not admit the trace normalisation; must be re-swept when drive settings change."}, {"id": "readme_gehre_2012", "label": "Gehre et al. 2012 (L1 sparsity EIT)", "file_type": "paper", "source_file": "README.md", "source_location": "L377", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_one_step_linearised", "label": "linear: one-step linearised reconstruction", "file_type": "concept", "source_file": "README.md", "source_location": "L434", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dbar_method", "label": "dbar: D-bar / Nachman direct method", "file_type": "concept", "source_file": "README.md", "source_location": "L440", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct inversion formula evaluated once: no iteration, no prior, no forward model in loop, cannot get stuck in local minima; cost is that its only knob is a low-pass filter so edges are not sharp. Needs L-1 independent patterns, so opposite drive cannot be used."}, {"id": "readme_nachman", "label": "Nachman's direct algorithm / boundary integral equation", "file_type": "paper", "source_file": "README.md", "source_location": "L440", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_scattering_transform", "label": "Scattering transform t(k)", "file_type": "concept", "source_file": "README.md", "source_location": "L442", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_truncation_radius_r", "label": "Truncation radius R (D-bar regularisation)", "file_type": "concept", "source_file": "README.md", "source_location": "L461", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R is a frequency in a plane normalised to the unit disk, so the same value means the same thing on any mesh/radius/background; no auto-scaling needed."}, {"id": "readme_t_growth", "label": "t_growth diagnostic", "file_type": "concept", "source_file": "README.md", "source_location": "L476", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measures how fast |t| still grows at the truncation radius; above ~20 the transform has blown up; best R sits at t_growth 10-15."}, {"id": "readme_born_approximation_texp", "label": "Born approximation t^exp", "file_type": "concept", "source_file": "README.md", "source_location": "L483", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_bie_scattering", "label": "bie: full scattering transform via boundary integral equation", "file_type": "concept", "source_file": "README.md", "source_location": "L487", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recovers contrast slightly better at moderate R but more fragile because the integral equation amplifies DN-map error like e^{2|k|}."}, {"id": "readme_klms_regularisation", "label": "Knudsen-Lassas-Mueller-Siltanen regularisation proof", "file_type": "paper", "source_file": "README.md", "source_location": "L486", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_faddeev_green_function", "label": "Faddeev Green's function", "file_type": "concept", "source_file": "README.md", "source_location": "L489", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dimensionless_lambda", "label": "Dimensionless lambda (trace(J^T W J)/trace(R) scaling)", "file_type": "rationale", "source_file": "README.md", "source_location": "L501", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data term size changes by orders of magnitude with mesh, drive amplitude and noise weighting; rescaling makes lambda~1 mean regularisation as strong as the data, comparable across settings."}, {"id": "readme_chi2_discrepancy_principle", "label": "chi2 per dof / discrepancy principle tuning", "file_type": "concept", "source_file": "README.md", "source_location": "L523", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs no ground truth so works on real data; pick lambda where chi2 ~ 1. Does not apply to dbar, which never minimises the data residual."}, {"id": "readme_prior_operators", "label": "Priors: laplacian, gaussian, tikhonov", "file_type": "concept", "source_file": "README.md", "source_location": "L409", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Laplacian is sparse and scales to any mesh (default); gaussian is statistically most meaningful but dense (n_cells^2 memory, n_cells^3 factorisation)."}, {"id": "readme_common_pixel_grid_metrics", "label": "Mesh-independent metrics on common pixel grid", "file_type": "rationale", "source_file": "README.md", "source_location": "L571", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Summing over cells of different meshes silently reweights error; comparing meshes is a first-class use case."}, {"id": "readme_rel_l2_roi", "label": "rel_L2_roi (default ranking metric)", "file_type": "concept", "source_file": "README.md", "source_location": "L593", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global errors are dominated by the easy background; ROI error measures whether inclusions were recovered."}, {"id": "readme_dice_fwhm", "label": "Dice with FWHM thresholding", "file_type": "concept", "source_file": "README.md", "source_location": "L596", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fixed threshold marks nearly the whole smooth reconstruction as inclusion and collapses the score for every algorithm."}, {"id": "readme_dynamic_range", "label": "dynamic_range metric", "file_type": "concept", "source_file": "README.md", "source_location": "L602", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_complete_electrode_model", "label": "Complete Electrode Model (CEM), P1/DG0", "file_type": "concept", "source_file": "README.md", "source_location": "L649", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_jacobian_sign_convention", "label": "Jacobian sign convention J = -dU/dsigma", "file_type": "concept", "source_file": "README.md", "source_location": "L663", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rank_deficiency", "label": "Jacobian rank deficiency (prior dominance)", "file_type": "concept", "source_file": "README.md", "source_location": "L668", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_validation_suite", "label": "Property-based validation suite (test_framework, test_dbar)", "file_type": "concept", "source_file": "README.md", "source_location": "L677", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_hossein_ostovar", "label": "Hossein Ostovar (TUHH)", "file_type": "concept", "source_file": "README.md", "source_location": "L774", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_moritz_hollenberg", "label": "Moritz Hollenberg (TUHH)", "file_type": "concept", "source_file": "README.md", "source_location": "L775", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_eit_framework", "target": "readme_three_stage_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L77", "weight": 1.0}, {"source": "readme_inverse_crime", "target": "readme_three_stage_pipeline", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L91", "weight": 1.0}, {"source": "readme_three_stage_pipeline", "target": "readme_ground_truth_bundle", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L84", "weight": 1.0}, {"source": "readme_three_stage_pipeline", "target": "readme_circular_mesh_generation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L80", "weight": 1.0}, {"source": "readme_drive_patterns", "target": "readme_cheney_isaacson", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L204", "weight": 1.0}, {"source": "readme_declarative_phantoms", "target": "readme_inverse_crime", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "L216", "weight": 1.0}, {"source": "readme_ground_truth_bundle", "target": "readme_declarative_phantoms", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L614", "weight": 1.0}, {"source": "readme_noise_relative_to_max", "target": "readme_eit_framework", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file